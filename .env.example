VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public half of the VAPID pair used for daily reminder push notifications.
# Generate with: npx web-push generate-vapid-keys
# The private half is a Supabase secret and must never appear here.
VITE_VAPID_PUBLIC_KEY=

# Only used by `npm run notify:test` to fire a reminder at a real device.
# Must match the Supabase secret of the same name. Never shipped to the client
# (no VITE_ prefix), and .env is git-ignored.
CRON_SECRET=
# Optional default recipient for `npm run notify:test`.
TEST_REMINDER_EMAIL=
