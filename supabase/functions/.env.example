# supabase/functions/.env — copy to supabase/functions/.env and fill in.
# Git-ignored. Used by `npm run server:dev` (supabase/functions/_local/serve.ts)
# to run every function locally, and by `supabase functions serve <fn>
# --env-file` for a single deployed-style function. Not consumed by the
# Vite/browser bundle — nothing here should have a VITE_ prefix.

# Same project as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the root .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Only needed by routes that bypass RLS (serviceClient in _shared/ai.ts) —
# doodles, word, notify, push.
SUPABASE_SERVICE_ROLE_KEY=

# AI-backed functions (ai, chat, word) — see "AI setup" above.
AI_PROVIDER=google
GOOGLE_API_KEY=

# Text-to-speech (ElevenLabs). Server-only: the key must never reach the
# browser, so no VITE_ prefix and no copy in the root .env. Get a key at
# https://elevenlabs.io/app/settings/api-keys — give it only the
# "Text to Speech" permission. Deployed functions read it from
# `supabase secrets set ELEVENLABS_API_KEY=…`, not from this file.
ELEVENLABS_API_KEY=
# Which voice speaks. Defaults to Sarah, one of ElevenLabs' built-in voices
# (same id on every account; clear American English). Other ids are on
# https://elevenlabs.io/app/voice-library. eleven_flash_v2_5 is the cheap,
# low-latency model, eleven_multilingual_v2 the higher-quality one.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# Daily reminders (notify) — see "Daily reminders (Web Push)" below.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Port supabase/functions/_local/serve.ts listens on.
PORT=8787
