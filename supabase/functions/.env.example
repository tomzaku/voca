# supabase/functions/.env — copy to supabase/functions/.env and fill in.
# Git-ignored. Used by `npm run server:dev` (supabase/functions/_local/serve.ts)
# to run every function locally, and by `supabase functions serve <fn>
# --env-file` for a single deployed-style function. Not consumed by the
# Vite/browser bundle — nothing here should have a VITE_ prefix.

# Same project as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the root .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Only needed by routes that bypass RLS (serviceClient in _shared/ai.ts) —
# doodles, word, notify, push.
SUPABASE_SERVICE_ROLE_KEY=

# AI-backed functions (ai, chat, word) — see "AI setup" above.
AI_PROVIDER=google
GOOGLE_API_KEY=

# Cloud voice (speech) — Google Cloud Text-to-Speech. A key from the project
# with "Cloud Text-to-Speech API" enabled (and allowed in the key's API
# restrictions). Leave empty to use GOOGLE_API_KEY above.
GOOGLE_TTS_API_KEY=
# All optional:
# GOOGLE_TTS_VOICE_FEMALE=en-US-Chirp3-HD-Aoede
# GOOGLE_TTS_VOICE_MALE=en-US-Chirp3-HD-Charon
# SPEECH_USER_DAILY_LIMIT=300
# SPEECH_TOTAL_DAILY_LIMIT=3000
# Hard monthly cap on characters sent to Google — keep it under the free
# allowance (1M for Chirp 3 HD, 4M for WaveNet/Standard) to never be billed.
# SPEECH_MONTHLY_CHAR_LIMIT=900000

# Daily reminders (notify) — see "Daily reminders (Web Push)" below.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Port supabase/functions/_local/serve.ts listens on.
PORT=8787
