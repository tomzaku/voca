{
  "name": "voca",
  "private": true,
  "version": "0.1.208",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "server:dev": "DENO_NO_PACKAGE_JSON=1 deno run --watch --allow-net --allow-env --allow-read --env-file=supabase/functions/.env supabase/functions/_local/serve.ts",
    "start:local": "concurrently -n server,client -c blue,green \"npm run server:dev\" \"VITE_API_BASE_URL=http://localhost:8787 vite\"",
    "start:prod": "VITE_API_BASE_URL= vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "cd supabase/functions && SUPABASE_URL=http://test SUPABASE_ANON_KEY=test deno test --allow-env hunts/ question-sets/",
    "preview": "vite preview",
    "db:push": "supabase db push",
    "db:migrate": "psql \"$DATABASE_URL\" -f supabase/migration.sql",
    "db:new": "node scripts/migrations.mjs new",
    "db:check": "node scripts/migrations.mjs check",
    "sync:database": "node scripts/sync-database.mjs",
    "deploy:functions": "supabase functions deploy",
    "deploy:functions:fast": "supabase functions deploy --use-api --jobs 4",
    "deploy:supabase": "npm run db:push && npm run deploy:functions",
    "deploy:progress": "supabase functions deploy progress",
    "deploy:messages": "supabase functions deploy messages",
    "deploy:teams": "supabase functions deploy teams",
    "deploy:hunts": "supabase functions deploy hunts",
    "deploy:question-sets": "supabase functions deploy question-sets",
    "deploy:tests": "supabase functions deploy tests",
    "deploy:friends": "supabase functions deploy friends messages",
    "deploy:questions": "supabase functions deploy questions pick",
    "deploy:writing-templates": "supabase functions deploy writing-templates",
    "notify:test": "node scripts/test-reminder.mjs",
    "doodles:backfill": "node scripts/backfill-doodles.mjs",
    "map:hue": "node scripts/generate-hue-map.mjs",
    "export:collections": "node scripts/export-system-collections.mjs",
    "export:tests": "node --env-file=supabase/functions/.env scripts/build-builtin-tests.mjs",
    "words:chain": "node scripts/build-chain-words.mjs",
    "senses:backfill": "node --env-file=.env scripts/backfill-senses.mjs",
    "examples:backfill": "node --env-file=.env scripts/backfill-example-translations.mjs",
    "lexicon:build": "node --env-file=.env scripts/build-lexicon.mjs",
    "speech:pregen": "AWS_PROFILE=voca node --env-file=.env scripts/pregen-speech.mjs",
    "speech:pregen:background": "taskpolicy -b npm run speech:pregen --",
    "speech:status": "npm run -s speech:pregen -- --dry-run",
    "speech:pregen:podcasts": "taskpolicy -b npm run speech:pregen -- --podcasts",
    "speech:status:podcasts": "npm run -s speech:pregen -- --podcasts --dry-run",
    "speech:pregen:scripts": "taskpolicy -b npm run speech:pregen -- --scripts",
    "speech:status:scripts": "npm run -s speech:pregen -- --scripts --dry-run",
    "speech:setup-mlx": "uv venv --allow-existing --python 3.12 ~/.cache/voca-mlx/.venv && uv pip install --python ~/.cache/voca-mlx/.venv/bin/python -r scripts/requirements-mlx.txt",
    "infra:audio:init": "terraform -chdir=infra/aws/audio-bucket init",
    "infra:audio:plan": "eval \"$(aws configure export-credentials --profile voca --format env)\" && terraform -chdir=infra/aws/audio-bucket plan",
    "infra:audio:apply": "eval \"$(aws configure export-credentials --profile voca --format env)\" && terraform -chdir=infra/aws/audio-bucket apply",
    "podcasts:translate": "node --env-file=.env scripts/translate-podcasts.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@iconify/react": "^6.0.2",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@supabase/supabase-js": "^2.99.1",
    "chess.js": "^1.4.0",
    "diff": "^8.0.4",
    "kokoro-js": "^1.2.1",
    "lottie-react": "^2.4.1",
    "onnxruntime-web": "1.18.0",
    "phaser": "^4.2.0",
    "phonemizer": "^1.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-intl": "^12.1.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-textarea-autosize": "^8.5.9",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "imagescript": "1.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "word-list": "^4.1.0",
    "wordnet-db": "^3.1.14",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
